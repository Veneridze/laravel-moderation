{
  "name": "veneridze/laravel-moderation",
  "description": "A simple Content Moderation System for Laravel 5.* that allows you to Approve or Reject resources like posts, comments, users, etc.",
  "keywords": [
    "laravel",
    "moderation",
    "moderation-system",
    "content-moderation"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Veneridze",
      "email": "viacheslav.kopaev@yandex.ru"
    },
    {
      "name": "Alex Kyriakidis",
      "email": "hootlex@icloud.com"
    }
  ],
  "autoload-dev": {
    "classmap": [
      "tests",
      "vendor/laravel/laravel/tests"
    ]
  },
  "require": {
    "php": ">=5.4.0",
    "spatie/laravel-package-tools": "^1.92"
  },
  "require-dev": {
    "laravel/laravel": "9.*|10.*|11.*|12.*",
    "beyondcode/laravel-dump-server": "~1.0"
  },
  "autoload": {
    "psr-4": {
      "Veneridze\\Moderation\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Veneridze\\Moderation\\ModerationServiceProvider"
      ]
    }
  }
}
